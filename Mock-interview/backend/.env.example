# --- Database ---
# Local MySQL example - format: mysql+mysqlconnector://<user>:<password>@<host>:3306/<db>
DATABASE_URL=mysql+mysqlconnector://root:4444@localhost:3306/interview_mock_db
# --- Auth ---
# Any long random string. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM: question generation, answer scoring, report ---
# Pick ONE provider:
#   ollama - a model running on your own PC through Ollama. Free, no API key. (see README)
#   openai - OpenAI's hosted API. Needs OPENAI_API_KEY and prepaid credit.
LLM_PROVIDER=ollama

# ollama provider
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window in tokens. 4096 fits this app's prompts; raising it uses more RAM.
OLLAMA_NUM_CTX=4096
# Seconds to wait for a reply. The first request after Ollama loads the model is the slowest.
OLLAMA_TIMEOUT=300

# openai provider
OPENAI_API_KEY=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
LLM_MODEL=gpt-4o-mini

# --- Retrieval (RAG): grounds questions and feedback in real source text ---
# Notes the answers are checked against live in backend/data/knowledge (add your own
# .md / .txt / .pdf files there and restart).
# Keyword search always works. For better matching on rephrased questions, also pull a
# small embedding model once:  ollama pull nomic-embed-text   (set RAG_EMBEDDINGS=off to disable)
RAG_EMBEDDINGS=auto
OLLAMA_EMBED_MODEL=nomic-embed-text
# openai provider only:
EMBED_MODEL=text-embedding-3-small
# Where ChromaDB keeps the knowledge-base embeddings (passages + vectors). Created
# automatically, safe to delete (it is rebuilt from backend/data/knowledge), not part of the source.
# RAG_CHROMA_PATH=data/chroma
# Relevance cut-offs. Lower = grounds more questions, higher = says "no reference" more often.
# RAG_MIN_COVERAGE=0.35
# RAG_MIN_SIMILARITY=0.70

# --- Speech-to-text: verbal answers ---
#   local  - faster-whisper on this PC. Free. One-time:  pip install -r requirements-local.txt
#   openai - hosted Whisper (same OPENAI_API_KEY and credit as above)
STT_PROVIDER=local
WHISPER_MODEL_SIZE=base
# Forcing English stops Whisper guessing the wrong language on short clips. Blank = auto-detect.
WHISPER_LANGUAGE=en
STT_MODEL=whisper-1

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
